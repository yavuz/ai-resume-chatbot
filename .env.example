# OpenAI uyumlu LLM endpoint'i. Varsayılan: resmi Gemini API (AI Studio API key).
# Başka bir OpenAI uyumlu endpoint (kendi gateway'in, OpenRouter vb.) için sadece URL/key/model değişir.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=change-me
LLM_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
# Boş bırakılırsa gönderilmez. Gemini için: minimal | low | medium | high
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=60
# Token kullanımını loglar (stream_options.include_usage). Endpoint desteklemiyorsa false yap.
LLM_STREAM_USAGE=true

# Botun yönlendireceği iletişim adresi
CONTACT_URL=https://www.linkedin.com/in/your-handle/

PROFILE_PATH=profile.md
SYSTEM_PROMPT_PATH=prompts/system.md
DB_PATH=data/chatbot.db

# IP adresleri bu salt ile hash'lenip saklanır. Uzun, rastgele bir değer ver:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_SALT=change-me

# Limitler
RATE_PER_IP_PER_MINUTE=6
RATE_PER_IP_PER_DAY=60
RATE_GLOBAL_PER_DAY=1000
MAX_MESSAGE_CHARS=1000
MAX_TURNS_PER_SESSION=30
HISTORY_MESSAGES=20
